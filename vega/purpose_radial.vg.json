{
    "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
    "title": {"text": "Why Australians Travel", "subtitle": "Domestic trips by purpose (2025)"},
    "width": "container",
    "height": 380,
    "autosize": {"type": "fit", "contains": "padding"},
    "data": {"url": "data/TRA_purpose.csv"},
    "mark": {
        "type": "arc",
        "innerRadius": 40,
        "cornerRadius": 10,
        "stroke": "white",
        "strokeWidth": 2
    },
    "encoding": {
        "theta": {
            "field": "trips",
            "type": "quantitative",
            "scale": {"domain": [0, 200000000]} 
        },
        "radius": {
            "field": "purpose",
            "type": "nominal",
            "scale": {"type": "band", "rangeMin": 40, "rangeMax": 170},
            "sort": {"field": "trips", "order": "descending"}
        },
        "color": {
            "field": "purpose",
            "type": "nominal",
            "scale": {"scheme": "set2"},
            "legend": {"title": "Reason for Travel"}
        },
        "tooltip": [
            {"field": "purpose", "type": "nominal", "title": "Purpose"},
            {"field": "trips", "type": "quantitative", "format": ",", "title": "Total Trips"}
        ]
    }
}