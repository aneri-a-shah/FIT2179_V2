{
    "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
    "title": {
        "text": "Collapse and recovery of Australian travel (Pre and Post COVID)"
    },
    "width": "container",
    "height": 500,
    "data": {"url": "data/ABS_covid.csv"},

    "transform": [
        {"calculate": "100", "as": "baseline_pct"},
        {"fold": ["baseline_pct", "low_pct", "recovery_pct"], "as": ["year_key", "pct"]},
        {"calculate": "datum.year_key == 'baseline_pct' ? '2019' : (datum.year_key == 'low_pct' ? '2020' : '2025')", "as": "year"}
    ],

    "layer": [
        {
            "mark": {"type": "rule", "color": "#888", "strokeDash": [4, 4]},
            "encoding": {"y": {"datum": 100}}
        },

        {
            "params": [
                {
                    "name": "country_hover",
                    "select": {
                        "type": "point",
                        "fields": ["country"],
                        "on": "mouseover",
                        "clear": "mouseout"
                    }
                }
            ],
            "mark": {"type": "line", "point": {"filled": true, "size": 35}},
            "encoding": {
                "x": {
                    "field": "year",
                    "type": "ordinal",
                    "title": null,
                    "axis": {"labelAngle": 0, "labelFontSize": 13, "labelFontWeight": "bold"}
                },
                "y": {
                    "field": "pct",
                    "type": "quantitative",
                    "title": "Visits as % of 2019 baseline",
                    "scale": {"domain": [0, 260]},
                    "axis": {"format": ".0f"}
                },
                "detail": {"field": "country", "type": "nominal"},
                "color": {
                    "field": "recovery_pct",
                    "type": "quantitative",
                    "scale": {"scheme": "redblue", "domainMid": 100, "domain": [50, 250]},
                    "legend": {"title": "2025 recovery (%)", "format": ".0f", "orient": "bottom", "direction": "horizontal", "titleAnchor": "middle", "titleOrient": "top"}
                },
                "opacity": {
                    "condition": {"param": "country_hover", "value": 1, "empty": true},
                    "value": 0.15
                },
                "strokeWidth": {
                    "condition": {"param": "country_hover", "value": 3.5, "empty": false},
                    "value": 1.5
                },
                "tooltip": [
                    {"field": "country", "type": "nominal"},
                    {"field": "category", "type": "nominal", "title": "Region"},
                    {"field": "year", "type": "ordinal"},
                    {"field": "pct", "type": "quantitative", "format": ".0f", "title": "% of 2019 baseline"},
                    {"field": "recovery_pct", "type": "quantitative", "format": ".0f", "title": "2025 recovery (%)"}
                ]
            }
        },

        {
            "transform": [
                {"filter": "datum.year == '2025' && (datum.country == 'Japan' || datum.country == 'United States of America')"}
            ],
            "mark": {"type": "text", "align": "left", "dx": 6, "fontWeight": "bold", "fontSize": 11, "color": "#333"},
            "encoding": {
                "x": {"field": "year", "type": "ordinal"},
                "y": {"field": "pct", "type": "quantitative"},
                "text": {"field": "country", "type": "nominal"}
            }
        }
    ]
}