{
    "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
    "title": {"text": "Top domestic destinations", "subtitle": "Dot size = overnight visits per year"},
    
    "width": "container",
    "height": 400,
    "autosize": {"type": "fit", "contains": "padding"},
    "projection": {"type": "mercator"},

    "layer": [
        {
            "data": {
                "url": "https://raw.githubusercontent.com/rowanhogan/australian-states/master/states.min.geojson",
                "format": {"type": "json", "property": "features"}
            },
            "mark": {"type": "geoshape", "fill": "#e5e5e5", "stroke": "#ffffff", "strokeWidth": 1.2}
        },

        {
            "data": {"url": "data/TRA_destinations.csv"},
            "mark": {"type": "circle", "opacity": 0.8, "stroke": "black", "strokeWidth": 0.5},
            "encoding": {
                "longitude": {"field": "lon", "type": "quantitative"},
                "latitude": {"field": "lat", "type": "quantitative"},
                "size": {
                    "field": "visits",
                    "type": "quantitative",
                    "scale": {
                        "type": "sqrt",
                        "domain": [0, 12000000],
                        "range": [0, 5000]
                    },
                    "legend": {"title": "Visits per year", "format": ".2s"}
                },
                "color": {
                    "field": "state",
                    "type": "nominal",
                    "legend": {"title": "State"}
                },
                "tooltip": [
                    {"field": "destination", "type": "nominal"},
                    {"field": "state", "type": "nominal"},
                    {"field": "visits", "type": "quantitative", "format": ",", "title": "Visits per year"}
                ]
            }
        }
    ]
}