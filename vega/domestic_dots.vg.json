{
    "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
    "title": {"text": "Top domestic destinations", "subtitle": "Dot size = overnight visits per year"},
    "width": "container",
    "height": 420,
    "projection": {"type": "mercator", "center": [134, -28], "scale": 600},

    "layer": [
        {
            "data": {
                "url": "data/aus_states.json",
                "format": {"type": "topojson", "feature": "aus_states_clean"}
            },
            "mark": {"type": "geoshape", "fill": "#f3f3f3", "stroke": "#bbb", "strokeWidth": 0.6}
        },
        {
            "data": {"url": "data/TRA_destinations.csv"},
            "params": [
                {
                    "name": "hover",
                    "select": {"type": "point", "on": "mouseover", "clear": "mouseout"}
                }
            ],
            "mark": {"type": "circle", "stroke": "white", "strokeWidth": 0.6},
            "encoding": {
                "longitude": {"field": "lon", "type": "quantitative"},
                "latitude": {"field": "lat", "type": "quantitative"},
                "size": {
                    "field": "visits",
                    "type": "quantitative",
                    "scale": {"type": "sqrt", "range": [40, 1400]},
                    "legend": {"title": "Visits per year", "format": ".2s", "orient": "bottom", "direction": "horizontal", "titleOrient": "top"}
                },
                "color": {
                    "field": "state",
                    "type": "nominal",
                    "legend": {"title": "State", "orient": "bottom", "direction": "horizontal", "titleOrient": "top"}
                },
                "opacity": {
                    "condition": {"param": "hover", "value": 0.85},
                    "value": 0.15
                },
                "tooltip": [
                    {"field": "destination", "type": "nominal"},
                    {"field": "state", "type": "nominal"},
                    {"field": "visits", "type": "quantitative", "format": ",", "title": "Visits per year"}
                ]
            }
        }
    ]
}