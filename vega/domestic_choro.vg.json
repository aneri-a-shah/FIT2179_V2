{
    "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
    "title": {"text": "Domestic visits by state", "subtitle": "Australian overnight visits, annual"},
    "width": 450,
    "height": 380,
    "projection": {"type": "mercator", "center": [133, -28], "scale": 550},
    "data": {
        "url": "https://raw.githubusercontent.com/FIT3179/Vega-Lite/main/3_choropleth_map/js/ne_50m_admin_1_states_provinces.topojson",
        "format": {"type": "topojson", "feature": "ne_50m_admin_1_states_provinces"}
    },
    "transform": [
        {
            "filter": "datum.properties.admin == 'Australia'"
        },
        {
            "lookup": "properties.name",
            "from": {
                "data": {"url": "data/TRA_state_visitors.csv"},
                "key": "state_full",
                "fields": ["state_code", "visits_domestic"]
            }
        }
    ],
    "mark": {"type": "geoshape", "stroke": "white", "strokeWidth": 0.8},
    "encoding": {
        "color": {
            "field": "visits_domestic",
            "type": "quantitative",
            "scale": {"scheme": "blues"},
            "legend": {"title": "Domestic visits", "format": ".2s"}
        },
        "tooltip": [
            {"field": "properties.name", "type": "nominal", "title": "State"},
            {"field": "state_code", "type": "nominal", "title": "Code"},
            {"field": "visits_domestic", "type": "quantitative", "format": ",", "title": "Visits"}
        ]
    }
}