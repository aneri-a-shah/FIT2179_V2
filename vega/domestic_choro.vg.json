{
    "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
    "title": {"text": "Domestic visits by state", "subtitle": "Australian overnight visits, annual"},
    "width": "container",
    "height": 420,
    "projection": {"type": "mercator", "center": [134, -28], "scale": 600},

    "data": {
        "url": "data/aus_states.json",
        "format": {"type": "topojson", "feature": "aus_states_clean"}
    },

    "transform": [
        {
            "lookup": "properties.STATE_NAME",
            "from": {
                "data": {"url": "data/TRA_state_visitors.csv"},
                "key": "state_full",
                "fields": ["state_code", "visits_domestic"]
            }
        }
    ],

    "mark": {"type": "geoshape", "stroke": "white", "strokeWidth": 0.8},

    "encoding": {
        "color": {
            "field": "visits_domestic",
            "type": "quantitative",
            "scale": {"scheme": "blues"},
            "legend": {"title": "Domestic visits", "format": ".2s", "orient": "bottom", "direction": "horizontal", "titleOrient": "top"}
        },
        "tooltip": [
            {"field": "properties.STATE_NAME", "type": "nominal", "title": "State"},
            {"field": "state_code", "type": "nominal", "title": "Code"},
            {"field": "visits_domestic", "type": "quantitative", "format": ",", "title": "Visits"}
        ]
    }
}