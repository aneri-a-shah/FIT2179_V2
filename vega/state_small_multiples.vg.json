{
    "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
    "title": {"text": "Individual Recovery", "subtitle": "2019-2025 trajectory"},
    "data": {"url": "data/TRA_international.csv"},
    
    "width": "container",
    "autosize": {"type": "fit", "contains": "padding"},
    
    "facet": {
        "field": "state",
        "type": "nominal",
        "columns": 4,
        "title": null,
        "header": {"labelFontSize": 11, "labelFontWeight": "bold"}
    },
    "spec": {
        "height": 120,
        "mark": {
            "type": "line", 
            "point": {"filled": true, "size": 30}, 
            "strokeWidth": 2
        },
        "encoding": {
            "x": {
                "field": "year",
                "type": "ordinal",
                "title": null,
                "axis": {"labelAngle": -45, "labelFontSize": 9}
            },
            "y": {
                "field": "visitors",
                "type": "quantitative",
                "title": "Visitors",
                "axis": {"format": ".2s", "titleFontSize": 10, "labelFontSize": 9}
            },
            "color": {
                "field": "state",
                "type": "nominal",
                "legend": null
            },
            "tooltip": [
                {"field": "state_full", "type": "nominal", "title": "State"},
                {"field": "year", "type": "ordinal", "title": "Year"},
                {"field": "visitors", "type": "quantitative", "format": ",", "title": "Visitors"}
            ]
        }
    }
}