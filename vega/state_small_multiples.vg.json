{
    "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
    "title": {"text": "Individual Recovery", "subtitle": "2019-2025 trajectory"},
    "data": {"url": "data/TRA_international.csv"},
    
    "facet": {
        "field": "state",
        "type": "nominal",
        "title": null,
        "header": {"labelFontSize": 11, "labelFontWeight": "bold"}
    },
    
    "columns": 4,
    
    "spec": {
        "width": 85,
        "height": 100,
        "mark": {
            "type": "line", 
            "point": {"filled": true, "size": 25}, 
            "strokeWidth": 2
        },
        "encoding": {
            "x": {
                "field": "year",
                "type": "ordinal",
                "title": null,
                "axis": {"labelAngle": -45, "labelFontSize": 9, "labelOverlap": true}
            },
            "y": {
                "field": "visitors",
                "type": "quantitative",
                "title": "Visitors",
                "axis": {"format": ".1s", "titleFontSize": 10, "labelFontSize": 9}
            },
            "color": {
                "field": "state",
                "type": "nominal",
                "scale": {
                    "domain": ["ACT", "NSW", "NT", "QLD", "SA", "TAS", "VIC", "WA"],
                    "scheme": "category10"
                },
                "legend": null
            },
            "tooltip": [
                {"field": "state_full", "type": "nominal", "title": "State"},
                {"field": "year", "type": "ordinal", "title": "Year"},
                {"field": "visitors", "type": "quantitative", "format": ",", "title": "Visitors"}
            ]
        }
    }
}