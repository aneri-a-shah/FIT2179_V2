{
    "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
    "title": {"text": "Budget Shifts Across the Year", "subtitle": "Category as % of total quarterly spend"},
    "width": "container",
    "height": 300,
    "autosize": {"type": "fit", "contains": "padding"},
    "data": {"url": "data/TRA_budget_data.csv"},
    "transform": [
        {
            "joinaggregate": [{"op": "sum", "field": "amount", "as": "TotalQuarterSpend"}],
            "groupby": ["quarter"]
        },
        {
            "calculate": "datum.amount / datum.TotalQuarterSpend",
            "as": "PercentOfBudget"
        }
    ],
    "mark": {"type": "rect", "tooltip": true, "cornerRadius": 4},
    "encoding": {
        "x": {
            "field": "quarter",
            "type": "nominal",
            "title": null,
            "sort": ["March", "June", "September", "December"],
            "axis": {"labelAngle": -45}
        },
        "y": {
            "field": "category",
            "type": "nominal",
            "title": null
        },
        "color": {
            "field": "PercentOfBudget",
            "type": "quantitative",
            "scale": {"scheme": "oranges"},
            "legend": {"title": "% of Budget", "format": ".0%"}
        },
        "tooltip": [
            {"field": "quarter", "type": "nominal", "title": "Quarter"},
            {"field": "category", "type": "nominal", "title": "Category"},
            {"field": "amount", "type": "quantitative", "title": "Actual Spend ($M)", "format": "$,.0f"},
            {"field": "PercentOfBudget", "type": "quantitative", "title": "Share of Budget", "format": ".1%"}
        ]
    }
}