{
    "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
    "title": {
        "text": "Which destinations recovered from COVID — and which didn't",
        "subtitle": "Australian visits in 2025 as a % of the 2019 baseline"
    },
    "width": "container",
    "height": 600,
    "data": {"url": "data/ABS_covid.csv"},

    "transform": [
        {"calculate": "datum.recovery_pct - 100", "as": "recovery_diff"}
    ],

    "layer": [
        {
            "mark": {"type": "rule", "color": "#999", "strokeWidth": 1, "strokeDash": [3, 3]},
            "encoding": {"x": {"datum": 100}}
        },

        {
            "mark": {"type": "bar", "stroke": "white", "strokeWidth": 0.5},
            "encoding": {
                "y": {
                    "field": "country",
                    "type": "nominal",
                    "sort": {"field": "recovery_diff", "order": "descending"},
                    "title": null,
                    "axis": {
                        "labelLimit": 200,
                        "labelFontSize": 11,
                        "domain": false,
                        "ticks": false,
                        "grid": false
                    }
                },
                "x": {
                    "field": "recovery_pct",
                    "type": "quantitative",
                    "title": "Australian visits in 2025 (% of 2019 baseline)",
                    "scale": {"domain": [0, 260]},
                    "axis": {"format": ".0f", "grid": false}
                },
                "x2": {"datum": 100},
                "color": {
                    "field": "recovery_pct",
                    "type": "quantitative",
                    "scale": {"scheme": "redblue", "domainMid": 100, "domain": [50, 250]},
                    "legend": null
                },
                "tooltip": [
                    {"field": "country", "type": "nominal"},
                    {"field": "category", "type": "nominal", "title": "Region"},
                    {"field": "visits_2019", "type": "quantitative", "format": ",", "title": "Visits in 2019 (baseline)"},
                    {"field": "visits_2020", "type": "quantitative", "format": ",", "title": "Visits in 2020 (COVID low)"},
                    {"field": "low_pct", "type": "quantitative", "format": ".0f", "title": "2020 as % of baseline"},
                    {"field": "visits_2025", "type": "quantitative", "format": ",", "title": "Visits in 2025"},
                    {"field": "recovery_pct", "type": "quantitative", "format": ".0f", "title": "2025 recovery (%)"}
                ]
            }
        },

        {
            "transform": [{"filter": "datum.recovery_pct >= 100"}],
            "mark": {"type": "text", "align": "left", "dx": 4, "fontSize": 10, "color": "#333"},
            "encoding": {
                "y": {
                    "field": "country",
                    "type": "nominal",
                    "sort": {"field": "recovery_diff", "order": "descending"}
                },
                "x": {"field": "recovery_pct", "type": "quantitative"},
                "text": {"field": "recovery_pct", "type": "quantitative", "format": ".0f"}
            }
        },

        {
            "transform": [{"filter": "datum.recovery_pct < 100"}],
            "mark": {"type": "text", "align": "right", "dx": -4, "fontSize": 10, "color": "#333"},
            "encoding": {
                "y": {
                    "field": "country",
                    "type": "nominal",
                    "sort": {"field": "recovery_diff", "order": "descending"}
                },
                "x": {"field": "recovery_pct", "type": "quantitative"},
                "text": {"field": "recovery_pct", "type": "quantitative", "format": ".0f"}
            }
        }
    ]
}